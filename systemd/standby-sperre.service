[Unit]
Description=Standby-Sperre — haelt den Laptop wach, solange der A1 druckt
Documentation=file://%h/projects/BambuLab_AI/README.md
After=network-online.target

[Service]
Type=simple
ExecStart=%h/projects/BambuLab_AI/sperre.sh
WorkingDirectory=%h/projects/BambuLab_AI
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
