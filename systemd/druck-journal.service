[Unit]
Description=Druck-Journal — schreibt laufend mit, wo der Druck steht
Documentation=file://%h/projects/BambuLab_AI/README.md
After=network-online.target

[Service]
Type=simple
ExecStart=%h/projects/BambuLab_AI/journal.sh
WorkingDirectory=%h/projects/BambuLab_AI
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
