[Unit]
Description=Stoerungs-Quittierer — drueckt bekannte Filamentfehler am A1 weg (max 3/10min)
Documentation=file://%h/projects/BambuLab_AI/README.md
After=network-online.target

[Service]
Type=simple
ExecStart=%h/projects/BambuLab_AI/quittierer.sh
WorkingDirectory=%h/projects/BambuLab_AI
Environment=DISPLAY=:1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
